# 行尾规则显式写死，别依赖各机器的 core.autocrlf
#
# 为什么 .bat 必须 CRLF：cmd.exe 解析 LF 结尾的批处理，goto / if 块的行为
# 不保证（历史上出现过脚本反复自重跑）。批处理文件就该是 Windows 格式。
* text=auto

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

*.md    text eol=lf
*.kts   text eol=lf
*.kt    text eol=lf
*.aidl  text eol=lf
*.xml   text eol=lf
*.pro   text eol=lf

*.apk   binary
*.aab   binary
*.aar   binary
*.jar   binary
*.jks   binary
*.keystore binary
